# Copy this file to ".env" (same folder as pom.xml) and fill in your own values.
# ".env" is git-ignored, so real credentials are never committed.

# --- PostgreSQL (leave DB_PASSWORD empty if your PostgreSQL does not ask for one) ---
DB_URL=jdbc:postgresql://localhost:5432/campus_lost_found
DB_USERNAME=your_postgres_username
DB_PASSWORD=

# --- JWT signing secret: at least 32 random characters. Generate one with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_secret
# JWT_EXPIRATION_MINUTES=60

# --- Google sign-in (optional): OAuth Client ID from Google Cloud Console (see README). Empty = disabled ---
GOOGLE_CLIENT_ID=

# --- First admin account, created at startup if the email is not used yet (password 8+ chars) ---
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@yourcampus.example
ADMIN_PASSWORD=choose_a_strong_password

# --- Frontend origins allowed to call the API (comma separated) ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Image uploads (optional): where pictures are stored on this server, and how long they are kept ---
# UPLOAD_DIR=uploads
# UPLOAD_ORPHAN_MAX_AGE_HOURS=24
# UPLOAD_RETENTION_DAYS=30
