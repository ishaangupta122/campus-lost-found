# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/campus_lost_found
DB_USERNAME=postgres
DB_PASSWORD=

# Secret used to sign login tokens (any text; keep it private)
JWT_SECRET=change-me

# First admin account, created at startup (password: 8+ characters)
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@lostfound.com
ADMIN_PASSWORD=change-me-123

# Optional: enables "Sign in with Google" (empty = disabled)
GOOGLE_CLIENT_ID=